---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  /** Pages without a hero → solid header from the top. */
  solidHeader?: boolean;
  hideStickyBar?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
}
const {
  title, description, path, ogImage,
  solidHeader = false, hideStickyBar = false, noindex = false, jsonLd = [],
} = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: non-blocking (display=swap), preconnected -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Archivo+Expanded:wght@700;800;900&display=swap"
    />

    <SeoHead title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} />

    <!-- Flip .no-js as early as possible so reveal content is never trapped hidden -->
    <script is:inline>document.documentElement.classList.remove('no-js');</script>

    <!--
      TODO(owner): Analytics/GTM/Pixel snippets load only when IDs are supplied
      in src/data/site.ts (site.analytics). Nothing tracks until then.
    -->
  </head>
  <body
    class="min-h-dvh bg-(--color-ink) text-(--color-bone) antialiased"
    data-solid-header={solidHeader ? 'true' : 'false'}
  >
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Scroll reveal (progressive enhancement; respects reduced motion) -->
    <script is:inline>
      (function () {
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal]');
        if (prefersReduced || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var delay = el.getAttribute('data-reveal-delay');
              if (delay) el.style.transitionDelay = delay + 'ms';
              el.classList.add('is-visible');
              io.unobserve(el);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
