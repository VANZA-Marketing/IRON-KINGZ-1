---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { currentYear } from '../data/site';

interface Props { title: string; description: string; path: string; updated?: string; }
const { title, description, path, updated = `${currentYear}` } = Astro.props;
---
<Layout title={`${title} — Iron Kingz`} description={description} path={path} solidHeader noindex>
  <section class="pt-28 md:pt-32 pb-8 bg-(--color-charcoal) border-b border-(--color-line)">
    <div class="container-ik max-w-3xl">
      <Breadcrumbs items={[{ label: title }]} />
      <h1 class="mt-6 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{title}</h1>
      <p class="mt-3 text-sm text-(--color-bone-dim)">Last updated: {updated}</p>
    </div>
  </section>
  <section class="py-14 bg-(--color-ink)">
    <div class="container-ik max-w-3xl legal-prose">
      <slot />
    </div>
  </section>
</Layout>

<style is:global>
  .legal-prose { color: var(--color-bone-dim); line-height: 1.75; }
  .legal-prose > * + * { margin-top: 1.1rem; }
  .legal-prose h2 { font-family: var(--font-display); text-transform: uppercase; color: var(--color-bone); font-size: 1.35rem; margin-top: 2.25rem; }
  .legal-prose a { color: var(--color-gold); text-decoration: underline; text-underline-offset: 3px; }
  .legal-prose ul { list-style: disc; padding-left: 1.25rem; }
  .legal-prose li { margin-top: 0.3rem; }
  .legal-prose strong { color: var(--color-bone); }
  .legal-note { border: 1px solid color-mix(in oklab, var(--color-gold) 40%, transparent); background: var(--color-charcoal); border-radius: var(--radius); padding: 1rem 1.15rem; font-size: 0.9rem; }
</style>
