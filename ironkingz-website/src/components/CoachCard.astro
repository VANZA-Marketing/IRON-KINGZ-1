---
import { Image } from 'astro:assets';
import type { Coach } from '../data/coaches';
import { coachInitials } from '../data/coaches';
import { img, alt } from '../data/images';

interface Props { coach: Coach; }
const { coach } = Astro.props;
const hasPhoto = Boolean(coach.image);
const image = hasPhoto ? img(coach.image!) : null;
---
<article
  class="group flex flex-col overflow-hidden rounded-(--radius-lg) border border-(--color-line) bg-(--color-charcoal)"
  data-reveal
>
  <div class="relative aspect-[4/5] overflow-hidden bg-(--color-graphite)">
    {image ? (
      <Image
        src={image}
        alt={alt(coach.image!) || `${coach.name}, ${coach.discipline} coach at Iron Kingz`}
        widths={[300, 480]}
        sizes="(max-width: 640px) 100vw, 25vw"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <!-- No approved photo yet → branded initials placeholder (not fabricated) -->
      <div class="flex h-full w-full items-center justify-center">
        <span class="font-display text-6xl text-(--color-line-strong) select-none">{coachInitials(coach)}</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink)/90 to-transparent"></div>
    <div class="absolute bottom-0 left-0 p-4">
      <span class="eyebrow">{coach.discipline}</span>
      <h3 class="mt-1 text-xl font-display uppercase leading-tight">{coach.name}</h3>
      {!coach.nameConfirmed && (
        <!-- Neutral label; real name pending owner confirmation. Not fabricated. -->
        <span class="sr-only">Name to be confirmed by the gym.</span>
      )}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <p class="text-sm text-(--color-bone-dim) leading-relaxed flex-1">{coach.philosophy}</p>
    <a href={`/coaches#${coach.slug}`} class="mt-4 text-sm font-semibold text-(--color-gold) hover:text-(--color-gold-bright) inline-flex items-center gap-1.5">
      Full Profile
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>
