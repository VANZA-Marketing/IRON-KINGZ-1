---
/**
 * Button / link. Renders <a> when `href` is set, otherwise <button>.
 * Variants tuned for the Iron Kingz system: gold primary spent sparingly.
 */
interface Props {
  href?: string;
  variant?: 'gold' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
  dataEvent?: string; // analytics event name (no-op until IDs configured)
  [key: string]: any;
}
const {
  href, variant = 'outline', size = 'md', type = 'button',
  class: className = '', id, dataEvent, ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-display uppercase tracking-wide ' +
  'transition-all duration-200 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-(--radius) ' +
  'cursor-pointer select-none focus-visible:outline-2 whitespace-nowrap';
const sizes: Record<string, string> = {
  md: 'text-sm px-5 py-3 min-h-[44px]',
  lg: 'text-base px-7 py-4 min-h-[52px]',
};
const variants: Record<string, string> = {
  gold:
    'bg-(--color-gold) text-(--color-ink) font-extrabold hover:bg-(--color-gold-bright) ' +
    'active:scale-[0.98] shadow-[0_0_0_1px_rgba(198,161,91,0.4)]',
  outline:
    'border border-(--color-line-strong) text-(--color-bone) hover:border-(--color-gold) ' +
    'hover:text-(--color-gold) active:scale-[0.98]',
  ghost:
    'text-(--color-bone) hover:text-(--color-gold) underline-offset-4',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---
{href ? (
  <a href={href} id={id} class={cls} data-event={dataEvent} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} id={id} class={cls} data-event={dataEvent} {...rest}>
    <slot />
  </button>
)}
