---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import { img, alt } from '../data/images';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string; // image registry key for background
  crumbs?: { label: string; href?: string }[];
  compact?: boolean;
}
const { eyebrow, title, subtitle, image, crumbs = [], compact = false } = Astro.props;
const bg = image ? img(image) : null;
---
<section class:list={['relative overflow-hidden grain', compact ? 'pt-28 pb-12' : 'pt-32 pb-16 md:pt-40 md:pb-20']}>
  {bg && (
    <div class="absolute inset-0 -z-10">
      <Image src={bg} alt={image ? alt(image) : ''} widths={[768, 1280, 1920]} sizes="100vw"
        class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-(--color-ink)/80"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/40 to-(--color-ink)/70"></div>
    </div>
  )}
  <div class="container-ik relative">
    {crumbs.length > 0 && <div class="mb-6"><Breadcrumbs items={crumbs} /></div>}
    {eyebrow && (
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-8 bg-(--color-gold-deep)"></span>
        <span class="eyebrow">{eyebrow}</span>
      </div>
    )}
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] max-w-4xl">{title}</h1>
    {subtitle && <p class="mt-5 text-lg md:text-xl text-(--color-bone-dim) max-w-2xl leading-relaxed">{subtitle}</p>}
    <slot />
  </div>
</section>
