---
import { Image } from 'astro:assets';
import type { Program } from '../data/programs';
import { img, alt } from '../data/images';
import { programLogo } from '../data/logos';

interface Props { program: Program; }
const { program } = Astro.props;
const image = img(program.cardImage);
const logo = programLogo(program.slug);
---
<article
  class="group relative flex flex-col overflow-hidden rounded-(--radius-lg) border border-(--color-line) bg-(--color-charcoal) transition-all duration-300 hover:border-(--color-gold)/60 hover:-translate-y-1"
  data-reveal
>
  <a href={`/programs/${program.slug}`} class="relative block aspect-[4/3] overflow-hidden">
    <Image
      src={image}
      alt={alt(program.cardImage)}
      widths={[400, 640, 800]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/30 to-transparent"></div>
    {logo && (
      <div class="absolute top-3 left-3 w-14 h-14 rounded-full bg-(--color-ink) border border-(--color-line-strong) p-1.5 flex items-center justify-center shadow-lg">
        <Image src={logo} alt={`${program.affiliate ?? program.name} logo`} widths={[96, 144]} class="w-full h-full object-contain" loading="lazy" />
      </div>
    )}
  </a>

  <div class="flex flex-1 flex-col p-5">
    {program.affiliate && <span class="eyebrow">{program.affiliate}</span>}
    <h3 class="mt-2 text-[length:var(--text-h3)] leading-tight">
      <a href={`/programs/${program.slug}`} class="hover:text-(--color-gold) transition-colors">{program.name}</a>
    </h3>
    <p class="mt-2.5 text-sm text-(--color-bone-dim) leading-relaxed flex-1">{program.short}</p>

    {program.ages && (
      <p class="mt-3 text-xs text-(--color-bone-dim)/80">
        <span class="text-(--color-gold)">Ages:</span> {program.ages.split('.')[0]}.
      </p>
    )}

    <div class="mt-5">
      <a href={`/programs/${program.slug}`} class="text-sm font-semibold text-(--color-bone) hover:text-(--color-gold) transition-colors inline-flex items-center gap-1.5">
        Explore Program
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</article>
