---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { mainNav } from '../data/nav';
import { introCtaLabel, bookHref } from '../lib/booking';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<header
  id="site-header"
  data-transparent
  class="fixed top-0 inset-x-0 z-(--z-nav) transition-colors duration-300 ease-[cubic-bezier(0.25,1,0.5,1)]"
>
  <div class="container-ik">
    <div class="flex items-center justify-between h-(--nav-h)">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0" aria-label="Iron Kingz home">
        <Logo class="h-11 md:h-14 w-auto" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        {mainNav.map((item) =>
          item.children ? (
            <div class="relative group" data-dropdown>
              <button
                type="button"
                class="nav-link flex items-center gap-1"
                aria-haspopup="true"
                aria-expanded="false"
                data-dropdown-trigger
              >
                {item.label}
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="transition-transform group-data-[open]:rotate-180">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div
                class="absolute left-0 top-full pt-2 min-w-[16rem] opacity-0 invisible translate-y-1 transition-all duration-200 group-data-[open]:opacity-100 group-data-[open]:visible group-data-[open]:translate-y-0"
                data-dropdown-menu
              >
                <ul class="bg-(--color-charcoal) border border-(--color-line) rounded-(--radius) overflow-hidden shadow-2xl py-1">
                  {item.overviewLabel && (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'block px-4 py-3 text-sm text-(--color-gold) hover:bg-white/5 transition-colors',
                          isActive(item.href) && 'text-(--color-gold)',
                        ]}
                      >
                        {item.overviewLabel}
                      </a>
                    </li>
                  )}
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block px-4 py-3 text-sm text-(--color-bone-dim) hover:text-(--color-gold) hover:bg-white/5 transition-colors',
                          isActive(child.href) && 'text-(--color-gold)',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class:list={['nav-link', isActive(item.href) && 'is-active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          )
        )}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={bookHref()}
          class="hidden sm:inline-flex items-center text-sm font-display uppercase tracking-wide text-(--color-bone) hover:text-(--color-gold) transition-colors"
          data-event="nav_book_click"
        >
          {introCtaLabel()}
        </a>

        <!-- Mobile menu toggle -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden inline-flex items-center justify-center w-11 h-11 text-(--color-bone) hover:text-(--color-gold) transition-colors"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
            <path d="M4 8h18M4 13h18M4 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu (accordion) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-(--z-modal) lg:hidden invisible opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-menu-overlay></div>
  <div
    class="absolute right-0 top-0 h-full w-full max-w-sm bg-(--color-ink) border-l border-(--color-line) translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col"
    data-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="flex items-center justify-between h-(--nav-h) px-5 border-b border-(--color-line)">
      <Logo class="h-10 w-auto" />
      <button type="button" id="mobile-close-btn" class="inline-flex items-center justify-center w-11 h-11 text-(--color-bone) hover:text-(--color-gold)" aria-label="Close menu">
        <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><path d="M6 6l14 14M20 6L6 20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-2 py-4" aria-label="Mobile">
      <ul class="flex flex-col">
        {mainNav.map((item) =>
          item.children ? (
            <li class="border-b border-(--color-line)/60">
              <button
                type="button"
                class="w-full flex items-center justify-between px-4 py-4 text-left font-display uppercase text-lg tracking-wide text-(--color-bone)"
                data-accordion-trigger
                aria-expanded="false"
              >
                {item.label}
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="transition-transform" data-accordion-icon>
                  <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out" data-accordion-panel>
                <ul class="overflow-hidden">
                  <li>
                    <a href={item.href} class="block pl-8 pr-4 py-3 text-sm text-(--color-gold)">{item.overviewLabel ?? item.label}</a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block pl-8 pr-4 py-3 text-sm text-(--color-bone-dim) hover:text-(--color-gold)">{child.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class="border-b border-(--color-line)/60">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class:list={['block px-4 py-4 font-display uppercase text-lg tracking-wide hover:text-(--color-gold)', isActive(item.href) ? 'text-(--color-gold)' : 'text-(--color-bone)']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="p-4 border-t border-(--color-line)">
      <Button href={bookHref()} size="lg" class="w-full" dataEvent="nav_book_click">{introCtaLabel()}</Button>
    </div>
  </div>
</div>

<style>
  .nav-link {
    position: relative;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bone);
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: var(--color-gold); }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.85rem; right: 0.85rem; bottom: 0.35rem;
    height: 1.5px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out-quart);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--color-gold); }
</style>

<script>
  // ---- Sticky/transparent header ----
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.removeAttribute('data-transparent');
      header.classList.add('bg-(--color-ink)', 'border-b', 'border-(--color-line)/70', 'shadow-lg');
    } else if (header.dataset.forceSolid !== 'true') {
      header.setAttribute('data-transparent', '');
      header.classList.remove('bg-(--color-ink)', 'border-b', 'border-(--color-line)/70', 'shadow-lg');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Pages without a hero want a solid header from the top.
  if (document.body.dataset.solidHeader === 'true' && header) {
    header.dataset.forceSolid = 'true';
    header.removeAttribute('data-transparent');
    header.classList.add('bg-(--color-ink)', 'border-b', 'border-(--color-line)/70');
  }

  // ---- Desktop dropdowns (hover + keyboard) ----
  document.querySelectorAll('[data-dropdown]').forEach((dd) => {
    const trigger = dd.querySelector('[data-dropdown-trigger]');
    const open = () => { dd.setAttribute('data-open', ''); trigger?.setAttribute('aria-expanded', 'true'); };
    const close = () => { dd.removeAttribute('data-open'); trigger?.setAttribute('aria-expanded', 'false'); };
    dd.addEventListener('mouseenter', open);
    dd.addEventListener('mouseleave', close);
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      dd.hasAttribute('data-open') ? close() : open();
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) close();
    });
    dd.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') close(); });
  });

  // ---- Mobile menu ----
  const menu = document.getElementById('mobile-menu');
  const panel = menu?.querySelector('[data-menu-panel]') as HTMLElement | null;
  const openBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const overlay = menu?.querySelector('[data-menu-overlay]');
  let lastFocused: HTMLElement | null = null;

  const openMenu = () => {
    if (!menu || !panel) return;
    lastFocused = document.activeElement as HTMLElement;
    menu.classList.remove('invisible', 'opacity-0');
    menu.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    openBtn?.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('scroll-locked');
    (menu.querySelector('a, button') as HTMLElement)?.focus();
  };
  const closeMenu = () => {
    if (!menu || !panel) return;
    panel.classList.add('translate-x-full');
    menu.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('scroll-locked');
    setTimeout(() => menu.classList.add('invisible', 'opacity-0'), 300);
    lastFocused?.focus();
  };
  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.getAttribute('aria-hidden') === 'false') closeMenu();
  });

  // ---- Mobile accordion ----
  document.querySelectorAll('[data-accordion-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('[data-accordion-icon]');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      panel.style.gridTemplateRows = expanded ? '0fr' : '1fr';
      icon?.classList.toggle('rotate-180', !expanded);
    });
  });
</script>
