---
/**
 * Iron Kingz logo — the original brand lockup (black shield/banner, gold
 * "IRON KINGZ" + crown + "THE KINGDOM"). Sourced from the live site.
 * `variant`/`mono` props are accepted for backward-compat but the single
 * lockup is used everywhere; control size via the `class` height utility.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/iron-kingz-logo.png';

interface Props {
  variant?: 'stacked' | 'horizontal' | 'icon';
  mono?: boolean;
  class?: string;
  title?: string;
}
const { class: className = 'h-12 w-auto', title = 'Iron Kingz — The Kingdom' } = Astro.props;
---
<Image
  src={logo}
  alt={title}
  widths={[220, 440, 736]}
  sizes="(max-width: 768px) 220px, 300px"
  class={`object-contain ${className}`}
  loading="eager"
/>
