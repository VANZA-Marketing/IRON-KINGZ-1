---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, intro, align = 'left', as: Tag = 'h2', class: className = '' } = Astro.props;
---
<div
  class:list={[
    'max-w-3xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
  data-reveal
>
  {eyebrow && (
    <div class:list={['flex items-center gap-3 mb-4', align === 'center' && 'justify-center']}>
      <span class="h-px w-8 bg-(--color-gold-deep)"></span>
      <span class="eyebrow">{eyebrow}</span>
    </div>
  )}
  <Tag class="text-[length:var(--text-h2)] leading-(--text-h2--line-height)">
    <slot name="title">{title}</slot>
  </Tag>
  {intro && <p class="mt-5 text-(--color-bone-dim) text-lg leading-relaxed">{intro}</p>}
</div>
