---
import type { Faq } from '../data/faqs';
interface Props { items: Faq[]; class?: string; }
const { items, class: className = '' } = Astro.props;

// Strip any bracketed internal TODO notes from public-facing answers.
const clean = (s: string) => s.replace(/\s*\[TODO\(owner\):[^\]]*\]/g, '').trim();
---
<div class:list={['divide-y divide-(--color-line)', className]}>
  {items.map((item) => (
    <details class="group faq-item">
      <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 list-none">
        <span class="font-display uppercase text-base md:text-lg tracking-wide text-(--color-bone) group-open:text-(--color-gold) transition-colors">{item.q}</span>
        <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full border border-(--color-line-strong) text-(--color-gold) transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </span>
      </summary>
      <div class="pb-5 -mt-1 text-(--color-bone-dim) leading-relaxed max-w-2xl">{clean(item.a)}</div>
    </details>
  ))}
</div>

<style>
  .faq-item summary::-webkit-details-marker { display: none; }
</style>
