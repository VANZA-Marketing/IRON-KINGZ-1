---
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
---
<nav aria-label="Breadcrumb" class="text-xs text-(--color-bone-dim)">
  <ol class="flex flex-wrap items-center gap-1.5">
    {all.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {c.href && i < all.length - 1 ? (
          <a href={c.href} class="hover:text-(--color-gold) transition-colors">{c.label}</a>
        ) : (
          <span class="text-(--color-bone)" aria-current="page">{c.label}</span>
        )}
        {i < all.length - 1 && <span class="text-(--color-line-strong)" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
