---
import Logo from './Logo.astro';
import { site, currentYear } from '../data/site';
import { moreNav } from '../data/nav';

const legal = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Accessibility', href: '/accessibility' },
  ...moreNav, // News, Gallery, Waiver
];
---
<footer class="relative bg-(--color-ink) border-t border-(--color-line) pt-14 pb-12">
  <div class="container-ik">
    <!-- Condensed: logo · contact · socials -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <a href="/" aria-label="Iron Kingz home" class="shrink-0"><Logo class="h-12 w-auto" /></a>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-(--color-bone-dim)">
        <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-(--color-gold)">{site.address.street}, {site.address.city} {site.address.postalCode}</a>
        <a href={site.phoneHref} class="hover:text-(--color-gold)" data-event="phone_click">{site.phone}</a>
        <a href={`mailto:${site.email}`} class="hover:text-(--color-gold)" data-event="email_click">{site.email}</a>
      </div>
      <div class="flex gap-3">
        {site.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}
             class="inline-flex items-center justify-center w-10 h-10 border border-(--color-line) rounded-(--radius) text-(--color-bone-dim) hover:text-(--color-gold) hover:border-(--color-gold) transition-colors">
            {s.name === 'Instagram' ? (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
            ) : (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.87.24-1.46 1.49-1.46H17V4.06C16.3 3.97 15.35 3.9 14.5 3.9c-2.35 0-3.96 1.44-3.96 4.08V10H7.9v3h2.64v8h2.96Z"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-(--color-line) flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-(--color-bone-dim)/70">© {currentYear} {site.legalName}</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {legal.map((l) => (
          <li><a href={l.href} class="text-xs text-(--color-bone-dim)/70 hover:text-(--color-gold) transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
