---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { img, photoMeta, type PhotoCategory } from '../data/images';

const catLabels: Record<PhotoCategory, string> = {
  boxing: 'Boxing', muaythai: 'Muay Thai', bjj: 'BJJ & MMA', keiki: 'Keiki',
  wingchun: 'Wing Chun', coaches: 'Coaches', fighters: 'Fighters',
  facility: 'Facility', community: 'Community', general: 'Training',
};
const keys = Object.keys(photoMeta);
const presentCats = Array.from(new Set(keys.map((k) => photoMeta[k].category)));
const orderedCats: PhotoCategory[] = (['boxing','muaythai','bjj','keiki','wingchun','coaches','fighters','community','facility','general'] as PhotoCategory[]).filter((c) => presentCats.includes(c));
---
<Layout
  title="Gallery — Iron Kingz Honolulu"
  description="Inside Iron Kingz: authentic photos of boxing, Muay Thai, BJJ, keiki classes, coaching, competition, and community in Mapunapuna, Honolulu."
  path="/gallery"
  solidHeader
>
  <PageHero
    eyebrow="Inside The Kingdom"
    title="Real training. Real people."
    subtitle="No stock photos — just Iron Kingz."
    crumbs={[{ label: 'Gallery' }]}
    compact
  />

  <section class="py-12 md:py-16 bg-(--color-ink)">
    <div class="container-ik">
      <!-- Filter chips -->
      <div class="flex flex-wrap gap-2 mb-8" id="gallery-filters" role="group" aria-label="Filter gallery">
        <button type="button" class="gfilter is-on" data-cat="all">All</button>
        {orderedCats.map((c) => (
          <button type="button" class="gfilter" data-cat={c}>{catLabels[c]}</button>
        ))}
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3" id="gallery-grid">
        {keys.map((k) => (
          <figure class="gitem relative overflow-hidden rounded-(--radius) group" data-cat={photoMeta[k].category}>
            <Image src={img(k)} alt={photoMeta[k].alt} widths={[300, 500, 700]} sizes="(max-width:768px) 50vw, 25vw" class="w-full h-full object-cover aspect-square transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <figcaption class="absolute inset-x-0 bottom-0 p-3 text-xs text-(--color-bone) bg-gradient-to-t from-(--color-ink)/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">{catLabels[photoMeta[k].category]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <style>
    .gfilter { padding:0.4rem 0.85rem; border-radius:9999px; border:1px solid var(--color-line-strong);
      font-size:0.8rem; font-weight:600; color:var(--color-bone-dim); transition:all 0.18s ease; cursor:pointer; min-height:36px; }
    .gfilter:hover { border-color:var(--color-gold); color:var(--color-bone); }
    .gfilter.is-on { background:var(--color-gold); border-color:var(--color-gold); color:var(--color-ink); }
  </style>

  <script>
    (function () {
      const filters = Array.from(document.querySelectorAll('.gfilter'));
      const items = Array.from(document.querySelectorAll('.gitem'));
      filters.forEach((btn) => btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.cat;
        filters.forEach((b) => b.classList.toggle('is-on', b === btn));
        items.forEach((it) => { (it as HTMLElement).hidden = !(cat === 'all' || (it as HTMLElement).dataset.cat === cat); });
      }));
    })();
  </script>
</Layout>
