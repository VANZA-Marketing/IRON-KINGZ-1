---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Button from '../../components/Button.astro';
import { programs } from '../../data/programs';
import { programLogo } from '../../data/logos';
import { startingFaqs } from '../../data/faqs';
import { bookHref, introCtaLabel } from '../../lib/booking';
import { faqJsonLd } from '../../lib/seo';

// Discipline strip (matches the four partner/academy logos), in reference order.
const disciplines = [
  { slug: 'bjj-keiki-mma', label: 'Brazilian Jiu-Jitsu' },
  { slug: 'muay-thai', label: 'Muay Thai Kickboxing' },
  { slug: 'boxing', label: 'Boxing' },
  { slug: 'wing-chun', label: 'Wing Chun' },
];
---
<Layout
  title="Programs — Boxing, Muay Thai, BJJ, Keiki MMA & Wing Chun"
  description="Explore Iron Kingz training programs in Honolulu: Iron Kingz Boxing, HFA Muay Thai & Kickboxing, 808 Top Team BJJ & Keiki MMA, and Wing Chun Hawaii. Beginner-friendly for kids and adults."
  path="/programs"
  solidHeader
  jsonLd={[faqJsonLd(startingFaqs)]}
>
  <PageHero
    eyebrow="Choose Your Training"
    title="Find the training that fits you."
    subtitle="Four disciplines under one roof in Mapunapuna — each from true beginner to competitor. Not sure where to start? Here’s what training at Iron Kingz is actually like."
    image="facility-pano"
    crumbs={[{ label: 'Programs' }]}
  />

  <!-- Discipline / academy logo strip -->
  <section class="py-12 md:py-16 bg-(--color-charcoal) border-b border-(--color-line)">
    <div class="container-ik">
      <p class="eyebrow text-center mb-8" data-reveal>Our Disciplines</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {disciplines.map((d) => {
          const logo = programLogo(d.slug);
          return (
            <a href={`/programs/${d.slug}`} class="group flex flex-col items-center text-center" data-reveal>
              <div class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-(--color-ink) border border-(--color-line-strong) group-hover:border-(--color-gold) transition-colors p-3 flex items-center justify-center">
                {logo && <Image src={logo} alt={`${d.label} logo`} widths={[140, 220]} class="w-full h-full object-contain" loading="lazy" />}
              </div>
              <span class="mt-4 font-display uppercase text-sm md:text-base tracking-wide text-(--color-bone) group-hover:text-(--color-gold) transition-colors">{d.label}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Program cards -->
  <section class="py-16 md:py-20 bg-(--color-ink)">
    <div class="container-ik grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map((p) => <ProgramCard program={p} />)}
    </div>
  </section>

  <!-- Quick comparison -->
  <section class="py-16 md:py-20 bg-(--color-charcoal) border-y border-(--color-line)">
    <div class="container-ik">
      <SectionHeading eyebrow="At a Glance" title="Which program is right for you?" />
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[46rem] text-left border-collapse">
          <thead>
            <tr class="border-b border-(--color-line-strong)">
              <th class="py-4 pr-4 font-display uppercase text-sm text-(--color-gold)">Program</th>
              <th class="py-4 px-4 font-display uppercase text-sm text-(--color-gold)">Beginners</th>
              <th class="py-4 px-4 font-display uppercase text-sm text-(--color-gold)">Ages</th>
              <th class="py-4 px-4 font-display uppercase text-sm text-(--color-gold)">Focus</th>
              <th class="py-4 pl-4"></th>
            </tr>
          </thead>
          <tbody>
            {programs.map((p) => (
              <tr class="border-b border-(--color-line) align-top">
                <td class="py-4 pr-4">
                  <a href={`/programs/${p.slug}`} class="font-display uppercase text-(--color-bone) hover:text-(--color-gold)">{p.name}</a>
                </td>
                <td class="py-4 px-4 text-sm text-(--color-bone-dim)">{p.beginnerFriendly ? 'Yes — welcome' : 'Experience recommended'}</td>
                <td class="py-4 px-4 text-sm text-(--color-bone-dim)">{p.ages.split('.')[0]}.</td>
                <td class="py-4 px-4 text-sm text-(--color-bone-dim)">Fitness &amp; competition</td>
                <td class="py-4 pl-4 text-right whitespace-nowrap">
                  <a href={`/programs/${p.slug}`} class="text-sm font-semibold text-(--color-bone-dim) hover:text-(--color-gold) transition-colors">View →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-(--color-ink)">
    <div class="container-ik grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <SectionHeading eyebrow="Getting Started" title="First-timer questions, answered." class="lg:sticky lg:top-28" />
      <FaqAccordion items={startingFaqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-(--color-charcoal) border-t border-(--color-line)">
    <div class="container-ik text-center">
      <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)]">Come try a class.</h2>
      <p class="mt-4 text-(--color-bone-dim) max-w-xl mx-auto">Book an intro and we’ll help you choose the right program for your goals.</p>
      <div class="mt-8"><Button href={bookHref()} size="lg" dataEvent="hero_book_click">{introCtaLabel()}</Button></div>
    </div>
  </section>
</Layout>
