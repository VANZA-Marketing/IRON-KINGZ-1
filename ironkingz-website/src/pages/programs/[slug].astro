---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CoachCard from '../../components/CoachCard.astro';
import Button from '../../components/Button.astro';
import { programs, getProgram } from '../../data/programs';
import { getCoach } from '../../data/coaches';
import { sessions, DAY_ORDER, DAY_FULL, type Day } from '../../data/schedule';
import { img, alt } from '../../data/images';
import { programLogo } from '../../data/logos';
import { bookHref, introCtaLabel } from '../../lib/booking';
import { faqJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return programs.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const program = getProgram(slug!)!;
const coachesFor = program.coachSlugs.map((s) => getCoach(s)).filter(Boolean);

// Program-specific schedule grouped by day
const progSessions = sessions.filter((s) => s.program === program.slug);
const byDay = DAY_ORDER.map((d) => ({
  day: d as Day,
  list: progSessions.filter((s) => s.days.includes(d as Day)).sort((a, b) => a.start.localeCompare(b.start)),
})).filter((g) => g.list.length > 0);

const columns = [
  { title: 'Who it’s for', items: program.whoFor },
  { title: 'What you’ll learn', items: program.learn },
  { title: 'A typical class', items: program.classIncludes },
];
const logo = programLogo(program.slug);
---
<Layout
  title={`${program.name} — Iron Kingz Honolulu`}
  description={program.short}
  path={`/programs/${program.slug}`}
  solidHeader
  jsonLd={[faqJsonLd(program.faqs)]}
>
  <PageHero
    eyebrow={program.affiliate}
    title={program.name}
    subtitle={program.positioning}
    image={program.heroImage}
    crumbs={[{ label: 'Programs', href: '/programs' }, { label: program.name }]}
  >
    {logo && (
      <div class="mt-6 w-20 h-20 rounded-full bg-(--color-ink) border border-(--color-line-strong) p-2.5 flex items-center justify-center shadow-lg">
        <Image src={logo} alt={`${program.affiliate ?? program.name} logo`} widths={[120, 160]} class="w-full h-full object-contain" loading="eager" />
      </div>
    )}
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={bookHref(program.slug)} size="lg" dataEvent="program_book_click">{introCtaLabel()}</Button>
      <Button href="/schedule" variant="outline" size="lg" dataEvent="schedule_view">View Schedule</Button>
    </div>
  </PageHero>

  <!-- Three columns: who / learn / class -->
  <section class="py-16 md:py-20 bg-(--color-ink)">
    <div class="container-ik grid gap-8 md:grid-cols-3">
      {columns.map((col) => (
        <div class="corner-bracket rounded-(--radius-lg) border border-(--color-line) bg-(--color-charcoal) p-7" data-reveal>
          <h2 class="font-display uppercase text-xl text-(--color-gold)">{col.title}</h2>
          <ul class="mt-4 space-y-3">
            {col.items.map((it) => (
              <li class="flex items-start gap-2.5 text-(--color-bone-dim) leading-relaxed">
                <svg width="16" height="16" viewBox="0 0 16 16" class="text-(--color-gold) mt-1 shrink-0" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Beginner / ages / equipment / safety -->
  <section class="py-16 md:py-20 bg-(--color-charcoal) border-y border-(--color-line)">
    <div class="container-ik grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="relative overflow-hidden rounded-(--radius-lg) vignette order-2 lg:order-1" data-reveal>
        <Image src={img(program.cardImage)} alt={alt(program.cardImage)} widths={[600, 900, 1200]} sizes="(max-width:1024px) 100vw, 50vw" class="w-full object-cover aspect-[4/3]" loading="lazy" />
      </div>
      <div class="order-1 lg:order-2 space-y-6" data-reveal>
        <SectionHeading eyebrow="Start Here" title="New to the mats? Good." />
        <p class="text-(--color-bone-dim) leading-relaxed">{program.beginnerNote}</p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <h3 class="footer-head text-(--color-gold)">Ages</h3>
            <p class="mt-2 text-sm text-(--color-bone-dim)">{program.ages}</p>
          </div>
          <div>
            <h3 class="footer-head text-(--color-gold)">What to bring</h3>
            <ul class="mt-2 text-sm text-(--color-bone-dim) space-y-1">
              {program.equipment.map((e) => <li>• {e}</li>)}
            </ul>
          </div>
        </div>
        <div>
          <h3 class="footer-head text-(--color-gold)">Safety</h3>
          <p class="mt-2 text-sm text-(--color-bone-dim)">{program.safety}</p>
        </div>
        {program.competition && (
          <div>
            <h3 class="footer-head text-(--color-gold)">Competition</h3>
            <p class="mt-2 text-sm text-(--color-bone-dim)">{program.competition}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Program schedule -->
  {byDay.length > 0 && (
    <section class="py-16 md:py-20 bg-(--color-ink)">
      <div class="container-ik">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading eyebrow="Weekly Schedule" title={`${program.name} class times`} class="max-w-xl" />
          <div data-reveal><Button href="/schedule" variant="outline">Full Schedule</Button></div>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {byDay.map((g) => (
            <div class="rounded-(--radius-lg) border border-(--color-line) bg-(--color-charcoal) overflow-hidden" data-reveal>
              <div class="px-4 py-3 border-b border-(--color-line) font-display uppercase text-(--color-gold)">{DAY_FULL[g.day]}</div>
              <ul class="divide-y divide-(--color-line)">
                {g.list.map((s) => (
                  <li class="px-4 py-3">
                    <div class="tnum text-sm text-(--color-bone) font-semibold">{s.startLabel}–{s.endLabel}</div>
                    <div class="text-sm text-(--color-bone-dim)">{s.title} · {s.ageLabel}</div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-(--color-bone-dim)/80">Weekend training is by appointment. <a href="/contact" class="text-(--color-gold) hover:underline">Contact us</a> to arrange a time.</p>
      </div>
    </section>
  )}

  <!-- Coaches -->
  {coachesFor.length > 0 && (
    <section class="py-16 md:py-20 bg-(--color-charcoal) border-y border-(--color-line)">
      <div class="container-ik">
        <SectionHeading eyebrow="Your Coach" title="Who you’ll train with" />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {coachesFor.map((c) => <CoachCard coach={c!} />)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-(--color-ink)">
    <div class="container-ik grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <SectionHeading eyebrow="Questions" title={`${program.name} FAQ`} class="lg:sticky lg:top-28" />
      <FaqAccordion items={program.faqs} />
    </div>
  </section>

</Layout>
