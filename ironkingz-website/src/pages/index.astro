---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';

import { programs } from '../data/programs';
import { site } from '../data/site';
import { img, alt } from '../data/images';
import { bookHref, introCtaLabel } from '../lib/booking';

const steps = [
  { n: '01', title: 'Choose your program' },
  { n: '02', title: 'Book your intro time' },
  { n: '03', title: 'Meet your coach & train' },
];

// Official Iron Kingz apparel — Break Point FC (external Shopify store).
const shopUrl = 'https://www.breakpointfc.com/collections/iron-kingz';
const gear = [
  { name: 'Academy Rash Guard', price: 40, image: 'https://cdn.shopify.com/s/files/1/1015/2003/files/8229AAcademyBlackWhiteRashGuards-1.jpg?v=1785968971', url: 'https://www.breakpointfc.com/products/iron-kingz-academy-rash-guards-black-white-8229-a' },
  { name: 'Shorts 2.0', price: 35, image: 'https://cdn.shopify.com/s/files/1/1015/2003/files/1833AAllBlackShorts2.0Mockup-IronKingz.jpg?v=1784065364', url: 'https://www.breakpointfc.com/products/iron-kingz-all-black-shorts-2-0-8229-a' },
  { name: 'Muay Thai Shorts', price: 35, image: 'https://cdn.shopify.com/s/files/1/1015/2003/files/1833AMuayThaiShortsMockup-IronKingz.jpg?v=1784065396', url: 'https://www.breakpointfc.com/products/iron-kingz-muay-thai-shorts-8229-a' },
  { name: 'Next Level Tee', price: 25, image: 'https://cdn.shopify.com/s/files/1/1015/2003/files/1833ANextLevelAdultShirtsMockup-IronKingz.jpg?v=1784065655', url: 'https://www.breakpointfc.com/products/iron-kingz-next-level-adult-shirts-8229-a' },
];
---
<Layout
  title="Iron Kingz — Honolulu Combat Sports & Martial Arts Gym"
  description={site.description}
  path="/"
>
  <Hero />

  <!-- 1 · PROGRAMS -->
  <section class="py-20 md:py-28 bg-(--color-ink)">
    <div class="container-ik">
      <SectionHeading eyebrow="Choose Your Training" title="Four disciplines. One Kingdom." />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {programs.map((p) => <ProgramCard program={p} />)}
      </div>
    </div>
  </section>

  <!-- 2 · MISSION + HOW TO START (merged) -->
  <section class="py-20 md:py-28 bg-(--color-charcoal) border-y border-(--color-line)">
    <div class="container-ik grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative order-2 lg:order-1 overflow-hidden rounded-(--radius-lg) vignette" data-reveal>
        <Image src={img('kids-team-belts')} alt={alt('kids-team-belts')}
          widths={[600, 900, 1200]} sizes="(max-width: 1024px) 100vw, 50vw"
          class="w-full h-full object-cover aspect-[4/3]" loading="lazy" />
      </div>
      <div class="order-1 lg:order-2" data-reveal>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-(--color-gold-deep)"></span>
          <span class="eyebrow">The Kingdom</span>
        </div>
        <h2 class="text-[length:var(--text-h2)] leading-(--text-h2--line-height)">
          Champions in life,<br />not only in the ring.
        </h2>
        <p class="mt-6 text-lg text-(--color-bone-dim) leading-relaxed">
          More than a gym — a community where everyone, at any level, can train,
          learn, and reach their goals. No experience needed.
        </p>

        <!-- Compact 3-step strip (replaces the separate "First Step" section) -->
        <ol class="mt-8 space-y-3">
          {steps.map((s) => (
            <li class="flex items-center gap-4">
              <span class="font-display text-2xl text-(--color-gold)/50 tnum w-8 shrink-0">{s.n}</span>
              <span class="font-display uppercase text-(--color-bone) tracking-wide">{s.title}</span>
            </li>
          ))}
        </ol>

        <div class="mt-8">
          <Button href="/our-story" variant="outline" size="lg">Our Story</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · SCHEDULE BAND (trimmed) -->
  <section class="relative py-24 md:py-32 overflow-hidden grain">
    <div class="absolute inset-0 -z-10">
      <Image src={img('facility-pano-2')} alt="" widths={[1280, 1920]} sizes="100vw" class="w-full h-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-(--color-ink)/85"></div>
    </div>
    <div class="container-ik text-center" data-reveal>
      <span class="eyebrow">Weekly Schedule</span>
      <h2 class="mt-4 text-[length:var(--text-h2)] leading-(--text-h2--line-height) max-w-2xl mx-auto">
        Classes seven days a week.
      </h2>
      <p class="mt-4 text-(--color-bone-dim)">Morning and evening. Kids and adults. Beginner to competition.</p>
      <div class="mt-8"><Button href="/schedule" variant="outline" size="lg" dataEvent="schedule_view">View The Schedule</Button></div>
    </div>
  </section>

  <!-- 4 · GEAR / SHOP -->
  <section class="py-20 md:py-28 bg-(--color-charcoal) border-y border-(--color-line)">
    <div class="container-ik">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Official Gear" title="Rep the Kingdom." class="max-w-xl" />
        <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-(--color-gold) hover:text-(--color-gold-bright) inline-flex items-center gap-1.5" data-reveal>
          Shop the Collection
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="mt-12 grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2">
        {gear.map((p) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col" data-reveal>
            <div class="relative overflow-hidden rounded-(--radius-lg) border border-(--color-line) bg-white aspect-square">
              <img src={p.image} alt={`Iron Kingz ${p.name}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
            </div>
            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="font-display uppercase text-sm text-(--color-bone) group-hover:text-(--color-gold) transition-colors">{p.name}</span>
              <span class="text-sm text-(--color-bone-dim) tnum">${p.price}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-(--color-bone-dim)/70">Official Iron Kingz apparel by Break Point FC — rash guards, shorts, tees &amp; more.</p>
    </div>
  </section>

  <!-- 5 · CLOSING CTA -->
  <section class="py-16 md:py-24 bg-(--color-ink)">
    <div class="container-ik">
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <span class="eyebrow">Ready When You Are</span>
        <h2 class="mt-4 text-[length:var(--text-h1)] leading-(--text-h1--line-height)">Your first round starts with one step.</h2>
        <div class="mt-8"><Button href={bookHref()} variant="outline" size="lg" dataEvent="hero_book_click">{introCtaLabel()}</Button></div>
      </div>
    </div>
  </section>
</Layout>
