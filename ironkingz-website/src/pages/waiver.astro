---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Liability Waiver — Iron Kingz Honolulu"
  description="Read and sign the Iron Kingz liability waiver before your first session. Required for all participants."
  path="/waiver"
  solidHeader
  noindex
>
  <section class="pt-28 md:pt-32 pb-20 bg-(--color-ink) min-h-[80vh]">
    <div class="container-ik max-w-3xl">
      <span class="eyebrow">Before You Train</span>
      <h1 class="mt-3 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">Liability Waiver</h1>
      <p class="mt-4 text-(--color-bone-dim) leading-relaxed">
        Every participant must read and sign this waiver before their first session at Iron Kingz.
        Read each section, add your initials, fill in your details, and sign at the bottom — you’ll
        receive a copy for your own records. Minors must be signed for by a parent or legal guardian.
      </p>

      <!-- Live Iron Kingz waiver (embedded from the gym's form provider) -->
      <div class="mt-8 rounded-(--radius-lg) overflow-hidden border border-(--color-line) bg-white shadow-2xl">
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/EDIaQVqzoN58Rij25CHa"
          style="width:100%; min-height:1600px; border:none; display:block;"
          id="inline-EDIaQVqzoN58Rij25CHa"
          data-layout="{'id':'INLINE'}"
          data-form-id="EDIaQVqzoN58Rij25CHa"
          data-height="1600"
          title="Iron Kingz Liability Waiver"
        ></iframe>
      </div>

      <p class="mt-6 text-sm text-(--color-bone-dim)/80">
        Trouble loading the form? You can also open it directly
        <a href="https://api.leadconnectorhq.com/widget/form/EDIaQVqzoN58Rij25CHa" target="_blank" rel="noopener noreferrer" class="text-(--color-gold) hover:underline">here</a>.
      </p>
    </div>
  </section>

  <script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
</Layout>
