---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { coaches, coachInitials } from '../data/coaches';
import { getProgram } from '../data/programs';
import { img, alt } from '../data/images';
import { bookHref, introCtaLabel } from '../lib/booking';

// Person JSON-LD only for coaches whose names are confirmed.
const personLd = coaches
  .filter((c) => c.nameConfirmed)
  .map((c) => ({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: c.name,
    jobTitle: c.role,
    worksFor: { '@type': 'SportsActivityLocation', name: 'Iron Kingz' },
  }));
---
<Layout
  title="Coaches — Iron Kingz Honolulu"
  description="Meet the Iron Kingz coaching team: boxing, HFA Muay Thai, 808 Top Team BJJ & Keiki MMA, and Wing Chun instructors in Mapunapuna, Honolulu."
  path="/coaches"
  solidHeader
  jsonLd={personLd}
>
  <PageHero
    eyebrow="The Corner"
    title="Coaches who’ve done the work."
    subtitle="You’re only as good as the people in your corner. Meet the team leading each program at Iron Kingz."
    image="coaches-team"
    crumbs={[{ label: 'Coaches' }]}
  />

  <section class="py-14 md:py-18 bg-(--color-ink)">
    <div class="container-ik grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {coaches.map((c) => {
        const program = getProgram(c.program);
        const hasPhoto = Boolean(c.image);
        return (
          <article id={c.slug} class="scroll-mt-28 flex flex-col" data-reveal>
            <div class="relative overflow-hidden rounded-(--radius-lg) border border-(--color-line) bg-(--color-graphite) aspect-[4/5]">
              {hasPhoto ? (
                <Image src={img(c.image!)} alt={alt(c.image!) || `${c.name}, ${c.discipline} coach at Iron Kingz`} widths={[400, 700]} sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, 33vw" class:list={['w-full h-full', c.imageFit === 'contain' ? 'object-contain' : 'object-cover', c.imageFit === 'contain' ? '' : (c.imagePos ?? 'object-center')]} loading="lazy" />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <span class="font-display text-6xl text-(--color-line-strong)">{coachInitials(c)}</span>
                </div>
              )}
            </div>
            <div class="mt-4 flex flex-1 flex-col">
              <span class="eyebrow">{c.discipline}</span>
              <h2 class="mt-1.5 text-[length:var(--text-h3)] leading-tight">{c.name}</h2>
              <p class="mt-1 text-sm text-(--color-gold) font-semibold">{c.role}</p>
              <p class="mt-3 text-sm text-(--color-bone-dim) leading-relaxed flex-1">{c.bio}</p>
              {program && (
                <div class="mt-4">
                  <a href={`/programs/${program.slug}`} class="text-sm font-semibold text-(--color-bone) hover:text-(--color-gold) inline-flex items-center gap-1.5">
                    {program.name}
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="relative py-24 md:py-32 overflow-hidden border-t border-(--color-line) grain">
    <div class="absolute inset-0 -z-10">
      <Image src={img('community-ring-group')} alt="" widths={[1280, 1920]} sizes="100vw" class="w-full h-full object-cover object-center" loading="lazy" />
      <div class="absolute inset-0 bg-(--color-ink)/80"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/40 to-(--color-ink)/70"></div>
    </div>
    <div class="container-ik text-center" data-reveal>
      <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)]">Train with the team.</h2>
      <div class="mt-8"><Button href={bookHref()} size="lg" dataEvent="hero_book_click">{introCtaLabel()}</Button></div>
    </div>
  </section>
</Layout>
