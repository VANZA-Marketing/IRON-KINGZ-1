---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { getProgram } from '../../data/programs';
import { img, alt } from '../../data/images';
import { bookHref, introCtaLabel } from '../../lib/booking';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const program = post.data.relatedProgram ? getProgram(post.data.relatedProgram) : undefined;
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const related = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .slice(0, 2);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: { '@type': 'Organization', name: 'Iron Kingz' },
  publisher: { '@type': 'Organization', name: 'Iron Kingz' },
  datePublished: post.data.pubDate.toISOString(),
};
---
<Layout
  title={`${post.data.title} — Iron Kingz`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogImage={post.data.image ? undefined : '/og/default.jpg'}
  solidHeader
  jsonLd={[articleLd]}
>
  <article>
    <!-- Header -->
    <header class="pt-28 md:pt-32 pb-10 bg-(--color-charcoal) border-b border-(--color-line)">
      <div class="container-ik max-w-3xl">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: post.data.title }]} />
        <span class="mt-6 inline-block eyebrow">{post.data.category}</span>
        <h1 class="mt-3 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{post.data.title}</h1>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-(--color-bone-dim)">
          <span>By {post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        </div>
      </div>
    </header>

    {post.data.image && (
      <div class="bg-(--color-ink)">
        <div class="container-ik max-w-4xl -mt-0 py-8">
          <Image src={img(post.data.image)} alt={alt(post.data.image)} widths={[600, 1000, 1400]} sizes="(max-width:1024px) 100vw, 900px" class="w-full rounded-(--radius-lg) object-cover aspect-[16/9]" loading="eager" />
        </div>
      </div>
    )}

    <div class="bg-(--color-ink) pb-16">
      <div class="container-ik grid gap-10 lg:grid-cols-[220px_1fr] max-w-5xl">
        <!-- TOC -->
        {toc.length > 2 && (
          <aside class="hidden lg:block">
            <div class="sticky top-28">
              <p class="footer-head text-(--color-gold)">On this page</p>
              <nav aria-label="Table of contents" class="mt-3">
                <ul class="space-y-2 text-sm border-l border-(--color-line)">
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`} class="block pl-3 -ml-px border-l border-transparent hover:border-(--color-gold) text-(--color-bone-dim) hover:text-(--color-gold) transition-colors">{h.text}</a></li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )}

        <!-- Body -->
        <div class="prose-ik max-w-2xl">
          <Content />

          <!-- Real CTA (replaces the source [BUTTON] placeholders) -->
          <div class="not-prose mt-12 rounded-(--radius-lg) border border-(--color-gold)/40 bg-(--color-charcoal) p-6 md:p-8">
            <h2 class="font-display uppercase text-xl">Start training in Honolulu</h2>
            <p class="mt-2 text-(--color-bone-dim)">Book an intro and we’ll help you take the first step.</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <Button href={bookHref(post.data.relatedProgram)} dataEvent="hero_book_click">{introCtaLabel()}</Button>
              <Button href={program ? `/programs/${program.slug}` : '/schedule'} variant="outline" dataEvent="schedule_view">{post.data.relatedScheduleLabel}</Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="py-14 bg-(--color-charcoal) border-t border-(--color-line)">
        <div class="container-ik max-w-5xl">
          <h2 class="font-display uppercase text-xl text-(--color-gold)">Keep reading</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {related.map((p) => (
              <a href={`/blog/${p.id}`} class="group flex gap-4 rounded-(--radius-lg) border border-(--color-line) bg-(--color-ink) p-4 hover:border-(--color-gold)/50 transition-colors">
                {p.data.image && <Image src={img(p.data.image)} alt="" widths={[160]} class="w-24 h-24 object-cover rounded-(--radius) shrink-0" loading="lazy" />}
                <span>
                  <span class="eyebrow">{p.data.category}</span>
                  <span class="mt-1 block font-display uppercase text-(--color-bone) group-hover:text-(--color-gold) leading-tight">{p.data.title}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  .prose-ik { color: var(--color-bone-dim); line-height: 1.75; }
  .prose-ik > * + * { margin-top: 1.15rem; }
  .prose-ik h2 { font-family: var(--font-display); text-transform: uppercase; color: var(--color-bone); font-size: 1.5rem; margin-top: 2.5rem; scroll-margin-top: 7rem; }
  .prose-ik h3 { font-family: var(--font-display); text-transform: uppercase; color: var(--color-bone); font-size: 1.15rem; margin-top: 1.75rem; }
  .prose-ik a { color: var(--color-gold); text-decoration: underline; text-underline-offset: 3px; }
  .prose-ik ul, .prose-ik ol { padding-left: 1.25rem; }
  .prose-ik ul { list-style: disc; }
  .prose-ik ol { list-style: decimal; }
  .prose-ik li { margin-top: 0.35rem; }
  .prose-ik strong { color: var(--color-bone); }
  .prose-ik blockquote { border-left: 2px solid var(--color-gold); padding-left: 1rem; font-style: italic; color: var(--color-bone); }
</style>
