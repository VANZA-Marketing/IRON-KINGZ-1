---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { bookHref, introCtaLabel } from '../lib/booking';
---
<Layout title="Page Not Found — Iron Kingz" description="The page you’re looking for isn’t here." solidHeader noindex>
  <section class="min-h-[70vh] flex items-center bg-(--color-ink)">
    <div class="container-ik text-center py-24">
      <p class="font-display text-7xl md:text-9xl text-(--color-gold)/25">404</p>
      <h1 class="mt-2 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">This round isn’t here.</h1>
      <p class="mt-4 text-(--color-bone-dim) max-w-md mx-auto">The page you’re looking for moved or doesn’t exist. Let’s get you back on track.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">Back to Home</Button>
        <Button href="/schedule" variant="outline" size="lg">View Schedule</Button>
        <Button href={bookHref()} variant="outline" size="lg">{introCtaLabel()}</Button>
      </div>
    </div>
  </section>
</Layout>
