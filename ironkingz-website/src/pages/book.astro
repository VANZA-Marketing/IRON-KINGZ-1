---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { introCtaLabel, introPriceDisplay, bookingEnabled } from '../lib/booking';

const trainingOptions = [
  { val: 'boxing', label: 'Boxing', img: 'boxing' },
  { val: 'muay-thai', label: 'Muay Thai / Kickboxing' },
  { val: 'bjj-keiki-mma', label: 'Brazilian Jiu-Jitsu / Keiki MMA' },
  { val: 'wing-chun', label: 'Wing Chun' },
  { val: 'not-sure', label: 'Not Sure — Help Me Choose' },
];
const price = introPriceDisplay();
const liveBooking = bookingEnabled();
---
<Layout
  title="Book Your Intro — Iron Kingz Honolulu"
  description="Book your introductory class at Iron Kingz in Honolulu. Choose your training, pick a time, and start with the fundamentals."
  path="/book"
  solidHeader
  hideStickyBar
  noindex
>
  <section class="pt-28 md:pt-32 pb-20 bg-(--color-ink) min-h-[80vh]">
    <div class="container-ik max-w-2xl">
      <div class="text-center">
        <span class="eyebrow">Book Your Intro</span>
        <h1 class="mt-3 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">Start Your First Class</h1>
        <p class="mt-4 text-(--color-bone-dim)">
          Three quick steps. Beginners welcome — no experience needed.
          {price && <span class="text-(--color-bone)"> Intro: <span class="font-semibold">{price}</span>.</span>}
        </p>
      </div>

      <!-- Progress -->
      <ol class="mt-10 flex items-center justify-between gap-2" id="wizard-steps">
        {['Choose Training', 'Date & Time', 'Your Details'].map((label, i) => (
          <li class="flex-1 flex items-center gap-2" data-step-indicator={i + 1}>
            <span class="step-dot flex items-center justify-center w-8 h-8 rounded-full border border-(--color-line-strong) text-sm font-bold tnum shrink-0">{i + 1}</span>
            <span class="hidden sm:block text-xs uppercase tracking-wide text-(--color-bone-dim)">{label}</span>
            {i < 2 && <span class="flex-1 h-px bg-(--color-line)"></span>}
          </li>
        ))}
      </ol>

      <form id="booking-form" class="mt-10" novalidate>
        <!-- STEP 1 -->
        <fieldset class="wizard-step" data-step="1">
          <legend class="font-display uppercase text-xl text-(--color-bone) mb-4">1 · What do you want to train?</legend>
          <div class="grid gap-3">
            {trainingOptions.map((o) => (
              <label class="training-opt flex items-center gap-3 rounded-(--radius) border border-(--color-line-strong) p-4 cursor-pointer hover:border-(--color-gold) transition-colors">
                <input type="radio" name="training" value={o.val} class="peer sr-only" required />
                <span class="w-5 h-5 rounded-full border-2 border-(--color-line-strong) peer-checked:border-(--color-gold) peer-checked:bg-(--color-gold) shrink-0 transition-colors"></span>
                <span class="font-display uppercase text-(--color-bone)">{o.label}</span>
              </label>
            ))}
          </div>
          <div class="mt-6 flex justify-end">
            <button type="button" class="wizard-next btn-gold" data-next="2">Continue</button>
          </div>
        </fieldset>

        <!-- STEP 2 -->
        <fieldset class="wizard-step hidden" data-step="2">
          <legend class="font-display uppercase text-xl text-(--color-bone) mb-4">2 · Pick a time</legend>

          {liveBooking ? (
            <div class="rounded-(--radius-lg) border border-(--color-line) overflow-hidden">
              {/* When configured, the confirmed Acuity/Squarespace scheduler embeds here. */}
              <iframe title="Book an intro appointment" src={site.booking.baseUrl} class="w-full min-h-[560px] bg-white"></iframe>
            </div>
          ) : (
            <div class="space-y-4">
              <div class="rounded-(--radius) border border-(--color-gold)/40 bg-(--color-charcoal) p-4 text-sm text-(--color-bone-dim)">
                Tell us when works best and we’ll confirm your intro time. (Live
                self-scheduling connects here once the gym’s booking account is linked.)
              </div>
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="bk-date" class="field-label">Preferred date</label>
                  <input id="bk-date" name="date" type="date" class="field" />
                </div>
                <div>
                  <label for="bk-time" class="field-label">Preferred time</label>
                  <select id="bk-time" name="time" class="field">
                    <option value="">Any time</option>
                    <option>Morning (9–11 AM)</option>
                    <option>Afternoon (3–5 PM)</option>
                    <option>Evening (5–9 PM)</option>
                  </select>
                </div>
              </div>
            </div>
          )}

          <div class="mt-6 flex justify-between">
            <button type="button" class="wizard-back btn-ghost" data-back="1">Back</button>
            {!liveBooking && <button type="button" class="wizard-next btn-gold" data-next="3">Continue</button>}
          </div>
        </fieldset>

        <!-- STEP 3 -->
        <fieldset class="wizard-step hidden" data-step="3">
          <legend class="font-display uppercase text-xl text-(--color-bone) mb-4">3 · Your details</legend>
          <div class="hidden" aria-hidden="true"><label>Leave blank<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="bk-first" class="field-label">First name <span class="text-(--color-gold)">*</span></label>
              <input id="bk-first" name="firstName" type="text" required autocomplete="given-name" class="field" />
              <p class="field-error" data-error-for="firstName"></p>
            </div>
            <div>
              <label for="bk-last" class="field-label">Last name <span class="text-(--color-gold)">*</span></label>
              <input id="bk-last" name="lastName" type="text" required autocomplete="family-name" class="field" />
              <p class="field-error" data-error-for="lastName"></p>
            </div>
            <div>
              <label for="bk-email" class="field-label">Email <span class="text-(--color-gold)">*</span></label>
              <input id="bk-email" name="email" type="email" required autocomplete="email" class="field" />
              <p class="field-error" data-error-for="email"></p>
            </div>
            <div>
              <label for="bk-mobile" class="field-label">Mobile phone <span class="text-(--color-gold)">*</span></label>
              <input id="bk-mobile" name="mobile" type="tel" required autocomplete="tel" class="field" />
              <p class="field-error" data-error-for="mobile"></p>
            </div>
          </div>

          <fieldset class="mt-4">
            <legend class="field-label">Who is training?</legend>
            <div class="flex gap-3">
              <label class="flex items-center gap-2 text-sm text-(--color-bone-dim)"><input type="radio" name="who" value="adult" checked class="accent-[var(--color-gold)]" /> Adult</label>
              <label class="flex items-center gap-2 text-sm text-(--color-bone-dim)"><input type="radio" name="who" value="minor" class="accent-[var(--color-gold)]" /> Minor</label>
            </div>
          </fieldset>

          <div id="minor-age-wrap" class="mt-4 hidden">
            <label for="bk-age" class="field-label">Student age</label>
            <input id="bk-age" name="age" type="number" min="1" max="17" class="field max-w-[8rem]" />
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mt-4">
            <div>
              <label for="bk-exp" class="field-label">Experience level</label>
              <select id="bk-exp" name="experience" class="field">
                <option>Complete beginner</option>
                <option>Some experience</option>
                <option>Experienced / competitor</option>
              </select>
            </div>
            <div>
              <label for="bk-goal" class="field-label">Primary goal</label>
              <select id="bk-goal" name="goal" class="field">
                <option>Fitness</option>
                <option>Learn to fight / self-defense</option>
                <option>Confidence & discipline</option>
                <option>Competition</option>
                <option>Kids’ development</option>
              </select>
            </div>
          </div>

          <div class="mt-4">
            <label for="bk-note" class="field-label">Injury or accessibility note (optional)</label>
            <textarea id="bk-note" name="note" rows="2" class="field resize-y"></textarea>
          </div>

          <label class="mt-4 flex items-start gap-3 text-sm text-(--color-bone-dim) cursor-pointer">
            <input type="checkbox" name="waiver" required class="mt-1 accent-[var(--color-gold)]" />
            <span>I understand I’ll complete the <a href="/waiver" class="text-(--color-gold) hover:underline">liability waiver</a> before training. <span class="text-(--color-gold)">*</span></span>
          </label>
          <p class="field-error" data-error-for="waiver"></p>

          <div class="mt-6 flex justify-between">
            <button type="button" class="wizard-back btn-ghost" data-back="2">Back</button>
            <button type="submit" class="btn-gold" data-event="booking_completed">{introCtaLabel()}</button>
          </div>
          <p class="mt-3 text-xs text-(--color-bone-dim)/70">
            Cancellations & rescheduling: contact the gym at least 24 hours ahead.
            {/* TODO(owner): confirm final cancellation/refund policy wording. */}
          </p>
        </fieldset>

        <!-- SUCCESS -->
        <div class="wizard-step hidden text-center py-10" data-step="done">
          <div class="mx-auto w-16 h-16 rounded-full bg-(--color-gold)/15 flex items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 32 32" class="text-(--color-gold)" aria-hidden="true"><path d="M8 16.5l5 5 11-12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h2 class="mt-5 text-[length:var(--text-h2)] font-display uppercase">Request Sent</h2>
          <p class="mt-3 text-(--color-bone-dim) max-w-md mx-auto" id="done-msg">We’ve opened your email app to send your intro request. We’ll confirm your time shortly.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/schedule" class="btn-ghost">View Schedule</a>
            <a href="/" class="btn-gold">Back to Home</a>
          </div>
        </div>
      </form>
    </div>
  </section>
</Layout>

<style>
  .btn-gold { display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:0 1.75rem;
    border-radius:var(--radius); background:var(--color-gold); color:var(--color-ink);
    font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:0.03em; cursor:pointer; transition:background 0.2s; }
  .btn-gold:hover { background:var(--color-gold-bright); }
  .btn-ghost { display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:0 1.5rem;
    border-radius:var(--radius); border:1px solid var(--color-line-strong); color:var(--color-bone);
    font-family:var(--font-display); text-transform:uppercase; letter-spacing:0.03em; cursor:pointer; transition:border-color 0.2s; }
  .btn-ghost:hover { border-color:var(--color-gold); color:var(--color-gold); }
  .field-label { display:block; font-size:0.8rem; font-weight:600; color:var(--color-bone); margin-bottom:0.35rem; }
  .field { width:100%; background:var(--color-charcoal); border:1px solid var(--color-line-strong); border-radius:var(--radius);
    padding:0.7rem 0.85rem; color:var(--color-bone); font-size:0.95rem; min-height:44px; }
  .field:focus { outline:2px solid var(--color-gold-bright); outline-offset:1px; }
  .field-error { color:var(--color-danger); font-size:0.78rem; margin-top:0.3rem; }
  .training-opt:has(input:checked) { border-color:var(--color-gold); background:color-mix(in oklab, var(--color-gold) 8%, transparent); }
  .step-dot.is-active { background:var(--color-gold); border-color:var(--color-gold); color:var(--color-ink); }
  .step-dot.is-done { border-color:var(--color-gold); color:var(--color-gold); }
</style>

<script is:inline define:vars={{ email: site.email, liveBooking }}>
  (function () {
    const form = document.getElementById('booking-form');
    if (!form) return;
    const steps = Array.from(form.querySelectorAll('.wizard-step'));
    const dots = Array.from(document.querySelectorAll('[data-step-indicator] .step-dot'));

    // Preselect training from ?program=
    const qp = new URLSearchParams(location.search).get('program');
    if (qp) {
      const radio = form.querySelector(`input[name="training"][value="${qp}"]`);
      if (radio) radio.checked = true;
    }

    function go(step) {
      steps.forEach((s) => s.classList.toggle('hidden', s.dataset.step !== String(step)));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i + 1 === Number(step));
        d.classList.toggle('is-done', i + 1 < Number(step));
      });
      const top = document.getElementById('wizard-steps');
      if (top) top.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    go(1);

    form.querySelectorAll('.wizard-next').forEach((btn) =>
      btn.addEventListener('click', () => {
        const cur = btn.closest('.wizard-step');
        if (cur.dataset.step === '1') {
          const picked = form.querySelector('input[name="training"]:checked');
          if (!picked) { alert('Please choose what you want to train.'); return; }
        }
        go(btn.dataset.next);
      })
    );
    form.querySelectorAll('.wizard-back').forEach((btn) =>
      btn.addEventListener('click', () => go(btn.dataset.back))
    );

    // Minor age toggle
    form.querySelectorAll('input[name="who"]').forEach((r) =>
      r.addEventListener('change', () => {
        document.getElementById('minor-age-wrap').classList.toggle('hidden', form.querySelector('input[name="who"]:checked').value !== 'minor');
      })
    );

    const setErr = (name, msg) => {
      const el = form.querySelector(`[data-error-for="${name}"]`);
      const field = form.querySelector(`[name="${name}"]`);
      if (el) el.textContent = msg || '';
      if (field && field.setAttribute) field.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (form.company && form.company.value) return; // honeypot
      const data = Object.fromEntries(new FormData(form).entries());
      let ok = true;
      ['firstName', 'lastName', 'email', 'mobile', 'waiver'].forEach((f) => setErr(f, ''));
      if (!String(data.firstName || '').trim()) { setErr('firstName', 'Required.'); ok = false; }
      if (!String(data.lastName || '').trim()) { setErr('lastName', 'Required.'); ok = false; }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(data.email || ''))) { setErr('email', 'Valid email required.'); ok = false; }
      if (String(data.mobile || '').replace(/\D/g, '').length < 7) { setErr('mobile', 'Valid phone required.'); ok = false; }
      if (!data.waiver) { setErr('waiver', 'Please acknowledge the waiver.'); ok = false; }
      if (!ok) { const fi = form.querySelector('[aria-invalid="true"]'); if (fi) fi.focus(); return; }

      // No live booking backend → send request via the user's email app (works today).
      const subject = encodeURIComponent(`Intro request — ${data.firstName} ${data.lastName} (${data.training})`);
      const body = encodeURIComponent(
        `INTRO CLASS REQUEST\n\nTraining: ${data.training}\nDate: ${data.date || 'any'} ${data.time || ''}\n\n` +
        `Name: ${data.firstName} ${data.lastName}\nEmail: ${data.email}\nMobile: ${data.mobile}\n` +
        `Who: ${data.who}${data.age ? ' (age ' + data.age + ')' : ''}\nExperience: ${data.experience}\nGoal: ${data.goal}\n` +
        `Note: ${data.note || '-'}\nWaiver acknowledged: yes`
      );
      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      go('done');
    });
  })();
</script>
